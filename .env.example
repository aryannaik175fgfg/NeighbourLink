# Copy to .env and adjust for local development

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql+psycopg://neighbourlink:neighbourlink_dev@127.0.0.1:5432/neighbourlink

# JWT / session
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# API
API_HOST=127.0.0.1
API_PORT=8742
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# App
APP_NAME=NeighbourLink
ENVIRONMENT=development

PAYMENT_HOLD_MINUTES=1440
PAYMENT_WEBHOOK_SECRET=nl-sandbox-webhook-secret
